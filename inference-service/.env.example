# Docker image places the official repository at /app/catvton.
CATVTON_REPO_PATH=/app/catvton
CATVTON_CHECKPOINT=zhengchong/CatVTON
CATVTON_BASE_MODEL=booksforcharlie/stable-diffusion-inpainting
CATVTON_DEVICE=cuda
CATVTON_PRECISION=bf16
CATVTON_WIDTH=768
CATVTON_HEIGHT=1024
CATVTON_STEPS=30
CATVTON_GUIDANCE_SCALE=2.5
# Required. Use a long random secret and copy its value to backend CATVTON_API_KEY.
SERVICE_API_KEY=replace-with-a-long-random-secret
# Optional Hugging Face token if your model access requires one.
HUGGING_FACE_HUB_TOKEN=
# Mount a RunPod persistent volume at /workspace to retain this cache between Pods.
HF_HOME=/workspace/huggingface
