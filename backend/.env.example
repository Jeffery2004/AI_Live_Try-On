PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Set to huggingface-space only after the Space build succeeds.
INFERENCE_PROVIDER=direct
# Set to the HTTPS URL of your deployed FastAPI CatVTON service, for example:
# CATVTON_API_URL=https://your-service.example.com/v1/try-on
CATVTON_API_URL=
# Must equal the SERVICE_API_KEY configured in the Python inference service.
CATVTON_API_KEY=
# Request duration allowed for one synchronous GPU generation.
CATVTON_REQUEST_TIMEOUT_MS=120000
# Hugging Face ZeroGPU Gradio Space (server-only token; never add it to frontend/.env)
HUGGINGFACE_SPACE_URL=
HUGGINGFACE_TOKEN=
HUGGINGFACE_REQUEST_TIMEOUT_MS=180000
